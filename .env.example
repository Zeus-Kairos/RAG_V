# Database
DB_URI=./data/rag_v.db

# Backend server
API_HOST=127.0.0.1
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# RAG
RAG_K=10

# Ollama (Playground chat)
# Example:
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=llama3.1
#   OLLAMA_API_KEY=   # optional (only if your Ollama/proxy requires it)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=

# General OpenAI-compatible LLM (text: hybrid doc augmentation, table summaries, and fallback for multimodal)
# Example (OpenRouter): LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional: dedicated multimodal endpoint/model (used by Multi-modal splitter when both URL and model are set)
# If unset, table/image LLM calls fall back to LLM_* above.
MULTIMODAL_LLM_BASE_URL=
MULTIMODAL_LLM_MODEL=
MULTIMODAL_LLM_API_KEY=

# Uploads
BASE_UPLOAD_DIR=uploads
SUPPORTED_FORMATS=.txt,.pdf,.md,.docx,.pptx,.xlsx,.html,.htm,.csv
MAX_FILE_SIZE=104857600
MAX_FILES_PER_UPLOAD=20
