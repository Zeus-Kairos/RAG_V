{
  "parsers": {
    "pdf": {
      "name": "PDF Parser",
      "defaultFramework": "pymupdf4llm",
      "frameworks": [
        {
          "name": "pypdf",
          "params": {
            "keep_layout": {
              "type": "boolean",
              "default": false,
              "label": "Keep Layout"
            }
          }
        },
        {
          "name": "pdfplumber",
          "params": {
            "x_tolerance": {
              "type": "int",
              "default": 3,
              "label": "X Tolerance"
            },
            "y_tolerance": {
              "type": "int",
              "default": 3,
              "label": "Y Tolerance"
            },
            "layout": {
              "type": "boolean",
              "default": false,
              "label": "Layout"
            }
          }
        },
        {
          "name": "pymupdf",
          "params": {
          }
        },
        {
          "name": "markitdown",
          "params": {}
        },
        {
          "name": "unstructured",
          "params": {}
        },
        {
          "name": "pymupdf4llm",
          "params": {
            "embed_images": {
              "type": "boolean",
              "default": false,
              "label": "Embed Images"
            },
            "use_ocr": {
              "type": "boolean",
              "default": false,
              "label": "Use OCR"
            }
          }
        },       
        {
          "name": "docling",
          "params": {
            "ocr_enable": {
              "type": "boolean",
              "default": false,
              "label": "Use OCR"
            },
            "table_enable": {
              "type": "boolean",
              "default": true,
              "label": "Enable Table"
            },
            "formula_enable": {
              "type": "boolean",
              "default": true,
              "label": "Enable Formula"
            },
            "code_enable": {
              "type": "boolean",
              "default": false,
              "label": "Enable Code"
            }
          }
        },
        {
          "name": "mineru",
          "params": {
            "table_enable": {
              "type": "boolean",
              "default": true,
              "label": "Enable Table"
            }
          }
        }
      ]
    },
    "docx": {
      "name": "DOCX Parser",
      "defaultFramework": "markitdown",
      "frameworks": [
        {
          "name": "markitdown",
          "params": {}
        },
        {
          "name": "unstructured",
          "params": {}
        },
        {
          "name": "docling",
          "params": {
          }
        }
      ]
    },
    "pptx": {
      "name": "PPTX Parser",
      "defaultFramework": "markitdown",
      "frameworks": [
        {
          "name": "markitdown",
          "params": {}
